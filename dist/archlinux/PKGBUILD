# Maintainer: 0xkee <0xkee@users.noreply.github.com>
pkgname=aggregate6
pkgver=0.2.0
pkgrel=1
pkgdesc='Fast CIDR prefix aggregation tool'
arch=('x86_64' 'aarch64')
url='https://github.com/0xkee/aggregate6'
license=('GPL-3.0-or-later')
depends=('glibc')
source=("$pkgname-$pkgver.tar.gz::https://github.com/0xkee/aggregate6/releases/download/v$pkgver/aggregate6-$pkgver.tar.gz")
sha256sums=('1faaa6f4124cb5ec6f252cbddf9df996a5957ad4e8f8beb614098db1fbeb685f')

build() {
	cd "$pkgname-$pkgver"
	make CC=gcc CFLAGS="$CFLAGS"
}

check() {
	cd "$pkgname-$pkgver"
	make test
}

package() {
	cd "$pkgname-$pkgver"
	make install PREFIX=/usr DESTDIR="$pkgdir"
}
