# Maintainer: 0xkee <0xkee@users.noreply.github.com>
pkgname=aggregate6
pkgver=0.3.1
pkgrel=1
pkgdesc='Fast multi-threaded IPv4/IPv6 CIDR prefix aggregation tool'
arch=('x86_64' 'aarch64')
url='https://github.com/0xkee/aggregate6'
license=('GPL-3.0-only')
depends=('glibc')
source=("$pkgname-$pkgver.tar.gz::https://github.com/0xkee/aggregate6/releases/download/v$pkgver/aggregate6-$pkgver.tar.gz")
sha256sums=('621b3c98b65653e56a688dbdb0381e6d92fdb2dc5e85bc62266330db6f29d0c0')

build() {
	cd "$pkgname-$pkgver"
	make CC=gcc CFLAGS="$CFLAGS"
}

check() {
	cd "$pkgname-$pkgver"
	make test
}

package() {
	cd "$pkgname-$pkgver"
	make install PREFIX=/usr DESTDIR="$pkgdir"
}
